PORT=3000

# Hors Docker : localhost. Dans Docker, surchargé à "postgres" par docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USER=brume
DB_PASSWORD=change-me
DB_NAME=brume

# Origines explicites, sans slash final. Utiliser le même site que l'API.
# Inclure l’origine de Swagger pour tester les POST depuis /api/docs.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Client OAuth Google de type "Application Web" (ne jamais commiter de vrais secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
AUTH_SUCCESS_URL=http://localhost:5173/compte

# false autorisé uniquement sur localhost ; true obligatoire en préproduction/production HTTPS
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=86400
# Démarrage ET callback partagent le compteur par IP : 20 requêtes/minute par défaut
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
# 0 en accès direct ; adapter uniquement à une chaîne de proxies maîtrisée.
AUTH_TRUST_PROXY_HOPS=0

# Emails transactionnels — Mailjet Send API v3.1 (aucune dépendance SMTP)
# EMAIL_ENABLED=false conserve les demandes en attente sans appeler Mailjet.
EMAIL_ENABLED=false
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Adresse expéditrice à valider dans Mailjet avant activation.
EMAIL_FROM=notifications@brume.test
EMAIL_FROM_NAME=Brume
FRONTEND_URL=http://localhost:5173
# Obligatoire pour register/forgot-password et toute mise en file, même si l’envoi est désactivé.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Conserver cette clé entre redémarrages ; ne jamais la commiter.
EMAIL_ENCRYPTION_KEY=
EMAIL_POLL_MS=5000
EMAIL_MAX_ATTEMPTS=5
