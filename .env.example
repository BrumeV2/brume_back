PORT=3000

# Hors Docker : localhost. Dans Docker, surchargé à "postgres" par docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USER=brume
DB_PASSWORD=change-me
DB_NAME=brume

# Origines explicites, sans slash final. Utiliser le même site que l'API.
CORS_ORIGIN=http://localhost:5173

# Client OAuth Google de type "Application Web" (ne jamais commiter de vrais secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
AUTH_SUCCESS_URL=http://localhost:5173/compte

# false autorisé uniquement sur localhost ; true obligatoire en préproduction/production HTTPS
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=86400
# Démarrage ET callback partagent le compteur par IP : 20 requêtes/minute par défaut
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
# 0 en accès direct ; adapter uniquement à une chaîne de proxies maîtrisée.
AUTH_TRUST_PROXY_HOPS=0
